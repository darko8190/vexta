{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "KeyPath": "./.data-protection-keys"
  },
  "Jwt": {
    "Issuer": "Vexta",
    "Audience": "VextaClient",
    "AccessTokenMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  }
}
