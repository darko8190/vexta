# Modèle des variables à saisir dans Dokploy (onglet « Environment » de l'application).
#
# Ce fichier sert de référence : il ne contient aucune valeur réelle et n'est jamais lu par
# l'application. Ne le remplissez pas ici — .env est ignoré par git, mais une valeur commitée
# par erreur reste dans l'historique pour toujours.
#
# Les clés d'API (Stripe, Mailgun, Cloudflare R2) ne figurent PAS ci-dessous. Elles se saisissent
# dans l'application, sous Intégrations, et sont chiffrées en base de données. Voir DEPLOIEMENT.md.

# ─── Obligatoire ──────────────────────────────────────────────────────────────────────────────

# Le domaine du site et de l'application.
WEB_DOMAIN=vexta.ca
# Le domaine de l'API. Il doit être public : Stripe y envoie ses webhooks et les fournisseurs
# d'authentification y renvoient le navigateur.
API_DOMAIN=api.vexta.ca

# Mot de passe PostgreSQL. 32 caractères ou plus, généré au hasard.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Clé de signature des jetons de session. 48 caractères ou plus : en dessous de 32 octets,
# l'algorithme HS256 refuse de démarrer.
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Le compte super admin, créé au tout premier démarrage sur une base vide. Le mot de passe doit
# faire au moins 10 caractères et contenir une majuscule, une minuscule et un chiffre.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ─── Optionnel ────────────────────────────────────────────────────────────────────────────────

# Valeurs par défaut si omis : vextaprod (ou vextaqa selon le compose) / vexta.
# POSTGRES_DB=vextaprod
# POSTGRES_USER=vexta

# Connexion sociale. Laissées vides, les boutons correspondants n'apparaissent pas.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Image de marque par défaut, utilisée tant que le super admin n'en a pas téléversé une depuis
# Apparence. N'importe quelle URL accessible par le navigateur.
# BRANDING_LOGO_LIGHT_URL=
# BRANDING_LOGO_DARK_URL=
# BRANDING_ICON_URL=
